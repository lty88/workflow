NODE_ENV=development
HOST=127.0.0.1
PORT=3100
# 开发时兼容同协议同端口的localhost与127.0.0.1；局域网或生产环境填写实际前端来源
APP_ORIGIN=http://localhost:5173
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=activity_workflow
MYSQL_USER=workflow
MYSQL_PASSWORD=replace-with-a-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
ADMIN_PASSWORD=123456
# 管理员和示例员工初始密码默认统一为123456，可自行修改为至少6位的密码
SEED_USER_PASSWORD=123456
UPLOAD_DIR=../../data/uploads
SESSION_HOURS=12

# 默认保留本地存储；填写有效凭据后改为oss，重启后新附件写入OSS，旧本地附件仍可读取。
STORAGE_DRIVER=local
OSS_REGION=oss-cn-beijing
OSS_BUCKET=qyzh2025test
OSS_DOMAIN=https://oss-test.qyzhjy.com
OSS_PREFIX=workflow
# 仅放服务端，不要加VITE_前缀或提交真实密钥。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
