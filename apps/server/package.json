{
  "name": "@workflow/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "tsx --env-file=../../.env src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "db:init": "tsx --env-file=../../.env src/db/init.ts",
    "db:setup": "tsx src/db/setup-local.ts",
    "db:reset-admin": "tsx src/db/reset-admin.ts",
    "test": "vitest run",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "db:seed-organization": "tsx --env-file=../../.env src/db/seed-organization.ts",
    "db:recover-members": "tsx --env-file=../../.env src/db/recover-members.ts",
    "db:seed-test-templates": "tsx --env-file=../../.env src/db/seed-test-templates.ts",
    "db:seed-demo-activities": "tsx --env-file=../../.env src/db/seed-demo-activities.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "11.2.1",
    "@workflow/domain": "workspace:*",
    "ali-oss": "^6.23.0",
    "fastify": "5.12.7",
    "mysql2": "3.24.6",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.4",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
